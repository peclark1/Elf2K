# AVI ELF II / Hyperboard — Netronics-compatible development ROM.
# Comments beginning with # ignored by romtext.
AVI ELF II / CHIP-8 27-GAME COM2 38400 (TEST ROM)
Default COM2: 38400 8N1, UART clock 614400 Hz.

SERIAL CONSOLE
    COM1 / 1               -- Q/EF4 fallback (requires J15)
    COM2 / 2               -- CDP1854 UART at 9600
    COM2 9600              -- select 9600
    COM2 19200 / 38400    -- requires correct x16 clock
    UART                   -- alias for COM2

PROGRAM CONTROL
    CALL addr              -- SCRT call
    RUN [addr]             -- execute with P=0
    CONT[inue]             -- resume from breakpoint
    ASM [NEW|OLD]          -- editor/assembler
    RUN F000               -- original Giant Monitor

CHIP-8: 1979 Netronics, 64x32 PIXIE
    CHIP8 FOUR             -- four-square test
    CHIP8 MAZE             -- Maze demo
    CHIP8 LIST             -- 27 games in ROM
    CHIP8 01..1B           -- launch game (hex ID)
    CHIP8                  -- launch RAM game at 0200
    ROM game copied to 0200; old game cleared.
    Interpreter/OS copied to RAM; preserves
    0200-09FF; initializes PIXIE and interrupts.
    Reset to exit; serial pauses during PIXIE.
    ETI-660 games (64x48) are incompatible.

CASSETTE - Q output / EF2 input; Netronics tape format
  CASSAVE start end   -- save RAM inclusive
  CASLOAD start end   -- load RAM inclusive
  CASSAVE TBASIC      -- save Tiny BASIC + program
  CASLOAD TBASIC      -- restore Tiny BASIC + program
  Hex addresses. PLAY/RECORD tape before key.
  CASLOAD overwrites RAM; COM1 cannot abort.

MEMORY / I-O
    E[xamine] addr [end]   -- read memory
    D[eposit] addr data..  -- change bytes
    HEX addr               -- interactive raw hexadecimal byte loader
      Bytes; optional hhhh: addresses; dot (.) ends.
    :llaaaattdddd..cc      -- Intel HEX record loader
    IN[put] port           -- read 1802 I/O port
    OU[tput] port data     -- write 1802 I/O port

DIAGNOSTICS
    SH[ow] EF              -- read EF1..EF4
    TE[st] RAM             -- RAM test
    TE[st] PIXIE           -- Enterprise video test
                              COM1 serial key exits
    HEL[p]                 -- this text
